# Copy to backend/.env and fill in. backend/.env is git-ignored.
# Used by scripts/setup-db.mjs and scripts/acceptance.sh. For the deployed function, set the
# same names (SHARED_API_KEY, DATABASE_ID, COLLECTION_ID, BUCKET_ID, ASSET_MAX_BYTES) as
# environment variables on the function in the Appwrite Console.

# --- Shared secret that clients send in the x-api-key header (the function checks it) ---
# Generate one:  openssl rand -base64 32
SHARED_API_KEY=

# --- Appwrite project (Console -> Settings) ---
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
# API key used ONLY by scripts/setup-db.mjs. Scopes: databases.*, tables.*, columns.*, rows.*,
# buckets.*, files.*  (read + write each). Delete it after setup.
APPWRITE_API_KEY=

# --- Names (defaults shown; change only if you want different IDs) ---
DATABASE_ID=brain
COLLECTION_ID=shared
BUCKET_ID=assets
ASSET_MAX_BYTES=10485760

# --- The deployed function's domain (Function -> Domains), no trailing /shared ---
SHARED_URL=https://<FUNCTION-ID>.<REGION>.appwrite.run
